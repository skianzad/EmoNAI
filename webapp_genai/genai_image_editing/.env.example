# Copy to .env and fill in keys, or run `python run_edits.py` and paste them when prompted.

# Nano Banana — Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Qwen-Image-3 — Alibaba Cloud Model Studio: https://modelstudio.console.alibabacloud.com/
DASHSCOPE_API_KEY=
# Optional. Default: https://dashscope-intl.aliyuncs.com/api/v1
# China: https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=

# Seedream 5.0 Pro — BytePlus ModelArk: https://console.byteplus.com/ark
# China Volcengine: https://console.volcengine.com/ark
ARK_API_KEY=
# BytePlus (default): https://ark.ap-southeast.bytepluses.com/api/v3
# China: https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=
# BytePlus: seedream-5-0-pro-260628
# China:    doubao-seedream-5-0-pro-260628
ARK_MODEL=seedream-5-0-pro-260628

# FLUX Kontext — Black Forest Labs: https://api.bfl.ai
BFL_API_KEY=

# Ideogram: https://developer.ideogram.ai
IDEOGRAM_API_KEY=

# GPT Image 2.5 — OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Images API: gpt-image-2.5-sunburst (quality) or gpt-image-2.5-flare (speed)
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Optional judge models for evaluate_edits.py
# OPENAI_JUDGE_MODEL=gpt-4.1
# GEMINI_JUDGE_MODEL=gemini-2.5-pro
# QWEN_JUDGE_MODEL=qwen-vl-max
# ByteDance vision judge (activate in Ark Console). Seedream 5.0 Pro is image-only.
# ARK_JUDGE_MODEL=seed-2-0-lite-260428
